      "Motor drive unit"
    ],
    "knowledge_status": "confirmed",
    "summary_zh": "用于驱动有载分接开关，并在面板上显示当前分接位置、机构状态和累计操作次数。",
    "readout_channels": [
      {
        "channel_id": "tap_position",
        "name_zh": "当前分接位置",
        "display_type": "discrete_pointer_dial",
        "quantity_kind": "tap_position",
        "unit": "tap_position",
        "value_format": "categorical_label",
        "semantics_zh": "外圈长指针指向当前离散分接位置标签。",
        "scales": []
      },
      {
        "channel_id": "mechanism_status",
        "name_zh": "机构状态",
        "display_type": "mechanical_status_indicator",
        "quantity_kind": "mechanism_state",
        "unit": "state",
        "value_format": "categorical_state",
        "semantics_zh": "内圈短指针和分区环用于指示分接变换过程以及机构是否到位。",
        "scales": [],
        "allowed_values": [
          "at_position",
          "in_transition"
        ]
      },
      {
        "channel_id": "operation_count",
        "name_zh": "累计操作次数",
        "display_type": "mechanical_counter",
        "quantity_kind": "event_count",
        "unit": "count",
        "value_format": "non_negative_integer",
        "semantics_zh": "机械计数窗累计记录电动机构完成分接操作的次数。",
        "scales": []
      }
    ],
    "interpretation_rules_zh": [
      "外圈长指针才是当前分接位置，内圈短指针和分区环是独立的机构状态通道。",
      "视觉模型可能只检测到内圈状态环；用于分接位置展示和裁剪的表盘区域必须同时覆盖外圈位置标签，模型原始框另行保留用于审计。",
      "分接位置是离散标签，不是连续物理量；字母后缀必须逐字保留，例如 9a、9b、9c 不能合并成 9。",
      "位置标签和位置数量由所配有载分接开关决定，不能把一台设备的标签序列作为所有 SHM-D 的固定量程。",
      "内圈指针位于底部到位分区时解释为机构已完成变换并到位。",
      "机械计数窗保留原始前导零，同时另存整数值；例如 003617 表示累计操作 3617 次。",
      "铭牌上的日期、重量和序列号不属于仪表读数通道。"
    ],
